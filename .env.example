# Copy this file to .env in the project root and fill in your own values.
# Existing process/cloud variables take precedence. Never commit .env.

# Model credentials. Direct Coding needs only CODING_API_KEY.
DEEPSEEK_API_KEY=
CODING_API_KEY=

# Three active Discord bots; the fourth agent is not configured yet.
DISCORD_COORDINATOR_BOT_TOKEN=
DISCORD_CODING_BOT_TOKEN=
DISCORD_WEB_BOT_TOKEN=

# Non-secret settings. Operator IDs are comma-separated human Discord IDs.
DISCORD_CHANNEL_ID=
# Separate channel for machine handoffs; required by the default Discord configuration.
DISCORD_BUS_CHANNEL_ID=
DISCORD_OPERATOR_IDS=
SYSTEM_WORKSPACE=.spirit-workspace
CODING_WORKSPACE=.coding-workspace
# Optional path to an installed Chromium; otherwise Playwright uses its managed browser.
WEB_BROWSER_EXECUTABLE_PATH=
